      "comment" : "Button in Settings > AI that asks the system again whether Apple Intelligence is available."
    },
    "Checking availability" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobando disponibilidad"
          }
        }
