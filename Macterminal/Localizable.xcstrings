{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      },
      "comment" : "Two sentences joined with a space in the empty state of a terminal pane: the first is the session message, the second the usage hint."
    },
    "%@ (from file)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (del archivo)"
          }
        }
      },
      "comment" : "Font picker option for a font family set in the configuration file that isn't in the list; the argument is the family name."
    },
    "%@ is already used by “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already used by “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya lo usa «%2$@»."
          }
        }
      },
      "comment" : "Error in the shortcut recorder: the first argument is the shortcut symbols, the second the name of the action that already uses it."
    },
    "%lld configuration warnings. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld configuration warnings. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld avisos en la configuración. %2$@"
          }
        }
      },
      "comment" : "Toast shown when the configuration file has several problems; the first argument is the count, the second the description of the first problem."
    },
    "%lld points" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld puntos"
          }
        }
      },
      "comment" : "VoiceOver value of the font size stepper in Settings > Appearance; spoken in full, not abbreviated."
    },
    "%lld pt" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pt"
          }
        }
      },
      "comment" : "Visible font size in Settings > Appearance. pt is the abbreviation of points."
    },
    "A long path is cut on the left with …/ so there’s always room to type." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ruta larga se recorta por la izquierda con …/ para que siempre quede sitio para escribir."
          }
        }
      },
      "comment" : "Description of the Folder picker in Settings > Prompt. …/ is shown literally in the prompt; keep it."
    },
    "AI" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA"
          }
        }
      },
      "comment" : "Tab title in the Settings window for the AI suggestions options."
    },
    "Abbreviated (~/P/Construct)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abreviada (~/P/Construct)"
          }
        }
      },
      "comment" : "Option of the Folder picker in Settings > Prompt: every folder but the last reduced to its first letter. Keep the example path as is."
    },
    "Add ⌘, ⌃ or ⌥: without them the shortcut would fire while you type." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ⌘, ⌃ o ⌥: sin ellos el atajo saltaría al escribir."
          }
        }
      },
      "comment" : "Error under the shortcut recorder in Settings when the shortcut has no modifier key. ⌘ ⌃ ⌥ are the Command, Control and Option key symbols."
    },
    "Advanced" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado"
          }
        }
      },
      "comment" : "Tab title in the Settings window for advanced options (shell path, configuration file)."
    },
    "Always" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre"
          }
        }
      },
      "comment" : "Option of the User and computer picker in Settings > Prompt."
    },
    "Another app already uses that Quake shortcut. Choose another combination." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra aplicación ya usa ese atajo Quake. Elige otra combinación."
          }
        }
      },
      "comment" : "Error in Settings when the global shortcut that shows the Quake terminal is taken by another app."
    },
    "Appearance" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apariencia"
          }
        }
      },
      "comment" : "Tab title in the Settings window for visual options (rain, font, greeting)."
    },
