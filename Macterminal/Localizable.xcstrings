      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence"
          }
        }
      },
      "comment" : "Row label in Settings > AI. Apple's product name; keep it."
    },
    "Applies to new tabs and panes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a pestañas y paneles nuevos"
          }
        }
      },
      "comment" : "Note in Settings: the change only affects tabs and panes opened afterwards."
    },
    "Autosuggestions" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosugerencias"
          }
        }
      },
      "comment" : "Toggle title in Settings > Prompt for inline gray suggestions of the rest of the command."
    },
    "Available" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible"
          }
        }
      },
      "comment" : "AI availability status in Settings > AI: Apple Intelligence can be used."
    },
    "Background opacity" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacidad del fondo"
          }
        }
      },
      "comment" : "Slider label in Settings > Appearance for how opaque the terminal window background is."
    },
    "Balanced" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrado"
          }
        }
      },
      "comment" : "Name of the middle Matrix rain intensity level (between Subtle and Immersive). Used as a picker option."
    },
    "Blocks aren’t available: the integration only works with zsh. Check the shell in Settings > Advanced." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bloques no están disponibles: la integración solo funciona con zsh. Revisa el shell en Ajustes > Avanzado."
          }
        }
      },
      "comment" : "Banner shown above the terminal when the command blocks feature is off because the shell isn't zsh. A block is one command with its output."
    },
    "Cancel" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      },
      "comment" : "Button in the AI suggestion card that cancels the request while it is loading."
    },
    "Check Again" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a comprobar"
          }
        }
