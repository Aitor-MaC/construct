{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ couldn’t be written to the zsh integration (errno %d)." : {
      "comment" : "Error shown when the shell integration can't be installed; the placeholders are a file name and errno.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn’t be written to the zsh integration (errno %2$d)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo escribir %1$@ en la integración de zsh (errno %2$d)."
          }
        }
      }
    },
    "%@ matches" : {
      "comment" : "Find bar counter with several matches; the placeholder is always 2 or more.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ coincidencias"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Find bar counter; the placeholders are the current match and the total.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ of more than %@" : {
      "comment" : "Find bar counter when the count is capped; the placeholders are the current match and the cap.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of more than %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de más de %2$@"
          }
        }
      }
    },
